NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com
YOUCAM_API_KEY=

GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_COLOR_MODEL=qwen/qwen3.8-27b

# Use your workspace-specific Model Studio base URL. Region and API key must match.
# Beijing: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# Singapore: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1
DASHSCOPE_API_BASE=
DASHSCOPE_API_KEY=
DASHSCOPE_QWEN_IMAGE_MODEL=qwen-image-3.0-pro

# Exact mobile/browser origins. Android's bundled Capacitor app uses https://localhost.
# Add development browser origins only on a development deployment.
MOBILE_ALLOWED_ORIGINS=https://localhost
# Vows & Vibe Pro Wedding Pass. Use the same entitlement ID in RevenueCat and the mobile build.
REVENUECAT_PRO_ENTITLEMENT=vows_vibes_pro
# Comma-separated product IDs accepted as the Wedding Pass if an entitlement mapping is delayed.
REVENUECAT_PRO_PRODUCT_IDS=vows_vibes_pro_lifetime,vows_vibes_pro_wedding_pass
REVENUECAT_SECRET_API_KEY=
# Keep true while using RevenueCat Test Store. Set false only for a production store release.
REVENUECAT_ALLOW_SANDBOX=true
# Must exactly match RevenueCat's Webhook Authorization header, including "Bearer ".
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Android signing SHA256 fingerprints: comma-separated colon-delimited fingerprints.
# Configure on the HTTPS invitation host to enable verified Android App Links.
ANDROID_APP_LINK_SHA256=
