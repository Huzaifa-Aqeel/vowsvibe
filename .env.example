# ─── Supabase ───────────────────────────────────────────────
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings > API > service_role (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=
# Used to build absolute invite links + redirect URLs for OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── YouCam / Perfect Corp AI Clothes Try-On / skin tone  API ───────────────
# https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# ─── Groq Vision (garment hex extraction) ──────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
