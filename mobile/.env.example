# Public mobile settings only. Never copy the backend .env.local into this directory.
# Demo is offline; live makes real requests and never substitutes demo responses.
VITE_APP_MODE=demo
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# HTTPS website that serves /invite/:code; defaults to the API origin.
VITE_INVITE_BASE_URL=
# Optional Perfect Corp guided browser camera; native selfie capture is the default.
VITE_CAMERA_KIT_ENABLED=false
# Optional RevenueCat public Test Store (test_) or live Android (goog_) key.
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_ENTITLEMENT=vows_vibes_pro
# Empty uses RevenueCat's current offering.
VITE_REVENUECAT_OFFERING=
