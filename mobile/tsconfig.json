{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "next/navigation": ["src/compat/navigation.tsx"],
      "next/link": ["src/compat/link.tsx"],
      "next/image": ["src/compat/image.tsx"],
      "@/lib/supabase/client": ["src/platform/supabase.ts"]
    }
  },
  "include": ["src", "tests/unit", "tests/browser", "*.ts"]
}
